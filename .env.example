# Docker Compose deployment config (copy to .env and fill values)

# Traefik
TRAEFIK_HOST=example.com

# Frontend (Laravel)
# Generate with: php -r "echo 'APP_KEY=base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
FRONTEND_APP_URL=https://example.com

# Backend (PHP API)
BACKEND_APP_URL=http://backend:8000
FRONTEND_BASE_URL=https://example.com

# Google OAuth (optional; required only if you want Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback

